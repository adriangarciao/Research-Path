# ResearchPath local environment — TEMPLATE ONLY (placeholders, safe to commit).
# Copy to `.env` (which is gitignored) and fill in real values:
#   Copy-Item .env.example .env
# `scripts\setup-env.ps1` does this for you and generates a strong DB password.
#
# Both Docker Compose (interpolation) and the scripts in scripts\ read `.env`.
# Spring Boot does NOT read this file by itself — start it with scripts\backend.ps1.

# ---- PostgreSQL (Docker Compose service `postgres`) ----
# Host port 5434 because 5433 is used by another local project on this machine.
DB_HOST=localhost
DB_PORT=5434
DB_NAME=researchpath
DB_USER=researchpath
DB_PASSWORD=change-me-local-only

# ---- OpenAlex (server-side only; never expose to the frontend) ----
# Paste your real key into `.env`, never into this file.
OPENALEX_API_KEY=
